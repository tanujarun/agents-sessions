/* agent-sessions: every colour, border and spacing value of the TUI.
 *
 * The look is NERV's (Neon Genesis Evangelion), and its rules are the show's:
 * black ground, and colour only where it means something. Orange is the system
 * speaking (frames, labels, the selection); green is nominal or live; red is
 * an alert or a loss; cyan is data from outside (another drive). The screen is
 * laid out as Central Dogma's monitors are: subjects as numbered plates in a
 * column, the log in the middle, a leader line out to the target readout
 * (state plate, seven-segment clock, data, the MAGI as three panels). Palette
 * after lotap's magi-theme. See tui/eva.py (shapes) and tui/crt.py (motion).
 *
 * The Python side holds no colour and reads the spacing it needs for fitting
 * (cell padding, tab padding, gutters) back from these rules.
 *
 * Widget tree:
 *   MainScreen#main                (.-wide: the subject column; .-side: the
 *                                   target readout right of the log;
 *                                   .-stacked: the readout under it; .-narrow
 *                                   below 80 columns; .-compact without it)
 *     #statusbar > #brand, #brand-sub, #brand-site, #status-message (.-info |
 *                  .-error), #status-summary (.-busy, .-blink while a job runs)
 *     #tabs > TabLabel.tab#tab-<provider> (.-active), #tab-all
 *     #deck > #subjects-box > SubjectColumn#subjects (subject--* classes)
 *             #board > #header (column headings), SessionList#list
 *             Leader#leader        the line from the selected row to the target
 *             #target > StatePlate#target-plate (plate--*), #target-clock-label,
 *                       SegmentClock#target-clock (clock--*),
 *                       #detail > .detail-row > .detail-label, .detail-value#detail-<field>
 *                       MagiPanel#magi  the three MAGI votes (magi--* classes)
 *     #stripe-top, #stripe-bottom  the hazard band of a prompt that is .-danger
 *     #prompt (.-caution | .-danger, .-flash as it arrives)
 *     #folderbar > #folder-label, Input#folder
 *     #filterbar > #filter-label, Input#filter
 *     KeyHints#hints               hints--key (a plate), hints--action
 *     BootLog#boot                 the boot log, on its own layer (motion only)
 *   HelpScreen > #help > #help-title, #help-text, #help-hint
 *   TranscriptScreen#pager > #pager-title, TranscriptView#pager-body,
 *                            #pager-footer > #pager-hints, #pager-status (.-error)
 * Every screen styles crt--noise (the raster band), crt--bloom (a line just
 * painted) and crt--old (the picture the band has not reached).
 */

$void: #000000;
$nerv: #ec7420;        /* the system: frames, labels, the selection */
$amber: #f4b000;       /* values, titles */
$alert: #f02020;       /* alert, loss, danger */
$alert-deep: #a80808;  /* the ground of a danger band */
$nominal: #50ff10;     /* nominal, live, approve */
$mint: #60f0a0;        /* numerals */
$external: #40c8e8;    /* data from another drive */
$grid: #484848;        /* rules, the inactive */
$ink: #e8e8e8;         /* text */
$dim: #8a8a8a;         /* secondary text */
$ember: #2a1300;       /* the dark of an orange plate */
$phosphor: #ffffff;    /* a line the raster has just painted */
$ember-lit: #7a3a10;   /* the first step of a lit cell */

Screen {
    background: $void;
    color: $ink;
}

/* --- status line --------------------------------------------------------- */
Screen > .crt--noise {
    color: $nominal;
}
Screen > .crt--bloom {
    color: $phosphor;
    text-style: bold;
}
Screen > .crt--old {
    text-style: dim;
}
MainScreen {
    layers: base boot;
}

#statusbar {
    height: 1;
}
/* With the subjects in a column there is no strip of plates under the
 * status line: a rule takes its place. */
#main.-wide #statusbar {
    height: 2;
    border-bottom: heavy $nerv;
}
#brand-site {
    width: auto;
    height: 1;
    padding: 0 1;
    color: $nerv;
    text-style: bold;
}
#brand {
    width: auto;
    height: 1;
    padding: 0 1;
    background: $alert;
    color: $void;
    text-style: bold;
}
#brand-sub {
    width: auto;
    height: 1;
    padding: 0 1;
    color: $alert;
}
#status-message {
    width: 1fr;
    height: 1;
    padding: 0 1;
    color: $nerv;
    text-style: bold;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}
#status-message.-info {
    color: $amber;
    text-style: none;
}
#status-message.-error {
    color: $alert;
    text-style: bold;
}
#status-summary {
    width: auto;
    height: 1;
    padding: 0 1;
    color: $mint;
    text-wrap: nowrap;
}
#status-summary.-busy {
    color: $nominal;
    text-style: bold;
}
#status-summary.-blink {
    background: $nominal;
    color: $void;
}

/* --- provider tabs: numbered plates --------------------------------------- */
#tabs {
    height: 1;
}
.tab {
    width: auto;
    height: 1;
    padding: 0 1;
    color: $nerv;
    text-wrap: nowrap;
}
.tab.-active {
    background: $nerv;
    color: $void;
    text-style: bold;
}

/* --- the deck: subjects, the log, the leader, the target ---------------------- */
#deck {
    height: 1fr;
}
#main.-stacked #deck {
    layout: vertical;
}
#subjects-box {
    width: 26;
    height: 1fr;
    border: solid $nerv;
    border-title-color: $amber;
    border-title-style: bold;
}
#subjects {
    height: auto;
}
#activity, #drives {
    height: auto;
    margin: 1 0 0 0;
}
#activity > .activity--title { color: $nerv; text-style: bold; }
#activity > .activity--note { color: $dim; }
#activity > .activity--cell-0 { color: $grid; }
#activity > .activity--cell-1 { color: $ember-lit; }
#activity > .activity--cell-2 { color: $nerv; }
#activity > .activity--cell-3 { color: $amber; }
#activity > .activity--cell-4 { color: $phosphor; text-style: bold; }
#activity > .activity--cell-x { color: $void; }
#drives > .drives--title { color: $nerv; text-style: bold; }
#drives > .drives--number { color: $nerv; }
#drives > .drives--name { color: $ink; text-style: bold; }
#drives > .drives--online { background: $nominal; color: $void; text-style: bold; }
#drives > .drives--standby { background: $amber; color: $void; text-style: bold; }
#drives > .drives--lost { background: $alert; color: $ink; text-style: bold; }
#drives > .drives--note { color: $dim; }
#drives > .drives--count { color: $mint; }
#subjects > .subject--frame { color: $nerv; }
#subjects > .subject--digits { color: $alert; text-style: bold; }
#subjects > .subject--name { color: $amber; text-style: bold; }
#subjects > .subject--count { color: $mint; }
#subjects > .subject--label { color: $dim; }
#subjects > .subject--number { color: $nerv; text-style: bold; }
#subjects > .subject--plate { color: $ink; }
#subjects > .subject--trace { color: $nominal; }
#subjects > .subject--trace-active { color: $nerv; }
#subjects > .subject--rule { color: $grid; }
#subjects > .subject--cursor { background: $nerv; color: $void; text-style: bold; }
#subjects > .subject--legend { color: $dim; }
#subjects > .subject--internal { color: $nominal; }
#subjects > .subject--external { color: $external; }
#subjects > .subject--lost { color: $alert; }

#leader {
    width: 3;
    height: 1fr;
}
#leader > .leader--line { color: $nerv; text-style: bold; }
#leader > .leader--flash { color: $phosphor; text-style: bold; }

#board {
    width: 1fr;
    height: 1fr;
    border: solid $nerv;
    border-title-color: $amber;
    border-title-style: bold;
    border-subtitle-color: $mint;
}
#header {
    height: 1;
    color: $amber;
    text-style: bold;
    text-wrap: nowrap;
}
#list {
    height: 1fr;
    overflow-x: hidden;
    scrollbar-size-vertical: 1;
    scrollbar-color: $nerv;
    scrollbar-color-hover: $amber;
    scrollbar-color-active: $amber;
    scrollbar-background: $ember;
    scrollbar-background-hover: $ember;
    scrollbar-background-active: $ember;
}
/* Padding of every cell: left + right of neighbours is the column spacing. */
#list > .session-list--cell {
    padding: 0 1;
}
#list > .session-list--row {
    color: $ink;
}
#list > .session-list--foreign {
    color: $dim;
}
#list > .session-list--cursor {
    background: $nerv;
    color: $void;
    text-style: bold;
}
#list > .session-list--ghost {
    background: $ember;
}
#list > .session-list--number {
    color: $mint;
}
#list > .session-list--mark {
    color: $nerv;
    text-style: bold;
}
#list > .session-list--age {
    color: $mint;
}
#list > .session-list--internal {
    color: $nominal;
}
#list > .session-list--external {
    color: $external;
}
#list > .session-list--imported {
    color: $external;
    text-style: dim;
}
#list > .session-list--lost {
    background: $alert-deep;
    color: $ink;
    text-style: bold;
}
#list > .session-list--track-grid { color: $grid; }
#list > .session-list--track-bar { color: $nerv; }
#list > .session-list--track-head { color: $amber; text-style: bold; }
#list > .session-list--meter-on { color: $nominal; }
#list > .session-list--meter-off { color: $grid; }
#list > .session-list--meter-count { color: $mint; }
#list > .session-list--empty {
    color: $alert;
    text-style: bold;
}

/* --- the target readout: plate, clock, data sheet, MAGI ---------------------------- */
#target {
    width: 48;
    height: 1fr;
    padding: 0 1;
    border: solid $nerv;
    border-title-color: $amber;
    border-title-style: bold;
}
#main.-stacked #target {
    width: 100%;
    height: auto;
    padding: 0;
    layout: horizontal;
    border: none;
}
#target-plate {
    height: 1;
    text-wrap: nowrap;
}
#target-plate > .plate--internal { background: $nominal; color: $void; text-style: bold; }
#target-plate > .plate--external { background: $external; color: $void; text-style: bold; }
#target-plate > .plate--imported { background: $external; color: $void; text-style: bold; }
#target-plate > .plate--lost { background: $alert; color: $ink; text-style: bold; }
#target-plate > .plate--none { background: $grid; color: $void; text-style: bold; }
#target-plate > .plate--word { color: $amber; text-style: bold; }
#target-plate > .plate--slash { color: $alert; }
#target-clock-label {
    height: 1;
    margin: 1 0 0 0;
    color: $nerv;
    text-wrap: nowrap;
}
#target-clock {
    height: 4;
    text-wrap: nowrap;
}
#target-clock > .clock--digits { color: $alert; text-style: bold; }
#target-clock > .clock--rolling { color: $amber; }
#target-clock > .clock--units { color: $dim; }
#main.-side #detail {
    margin: 1 0 0 0;
    border: none;
    border-top: solid $nerv;
}
#main.-side #detail-row-main {
    layout: grid;
    grid-size: 2;
    grid-columns: 13 1fr;
    height: 3;
}
#main.-side #detail-row-main > .detail-value {
    width: 1fr;
    padding: 0;
}
#main.-side #detail-row-note, #main.-side #detail-row-import {
    height: auto;
}
#main.-side #detail-note, #main.-side #detail-import {
    height: auto;
    text-wrap: wrap;
}
#main.-side #magi {
    width: 100%;
    height: auto;
    padding: 0;
    border: none;
    border-top: solid $nerv;
}
#detail {
    width: 1fr;
    height: auto;
    border: solid $nerv;
    border-title-color: $amber;
    border-title-style: bold;
}
.detail-row {
    height: 1;
}
.detail-label {
    width: 13;
    height: 1;
    padding: 0 1;
    color: $nerv;
}
.detail-value {
    width: 1fr;
    height: 1;
    color: $amber;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}
#detail-row-main > .detail-value {
    width: auto;
    padding: 0 3 0 0;
}
/* The id gives way (with an ellipsis) so messages and updated always fit. */
#detail-row-main > #detail-id {
    width: 1fr;
    min-width: 6;
}
#detail-import, #detail-note {
    color: $ink;
}
#magi {
    width: 38;
    height: auto;
    min-height: 5;
    padding: 0 1;
    border: solid $nerv;
    border-title-color: $amber;
    border-title-style: bold;
}
#magi > .magi--unit {
    color: $nerv;
    text-style: bold;
}
#magi > .magi--subject {
    color: $amber;
}
#magi > .magi--note {
    color: $dim;
}
#magi > .magi--approve {
    background: $nominal;
    color: $void;
    text-style: bold;
}
#magi > .magi--reject {
    background: $alert;
    color: $ink;
    text-style: bold;
}
#magi > .magi--pending {
    background: $amber;
    color: $void;
    text-style: bold;
}
#magi > .magi--conditional {
    background: $ember;
    color: $amber;
    text-style: bold;
}
#magi > .magi--none {
    color: $grid;
}
#magi > .magi--fill-approve { background: $nominal; color: $void; text-style: bold; }
#magi > .magi--fill-reject { background: $alert; color: $ink; text-style: bold; }
#magi > .magi--fill-pending { background: $amber; color: $void; text-style: bold; }
#magi > .magi--fill-conditional { background: $ember; color: $amber; text-style: bold; }
#magi > .magi--fill-none { color: $grid; }
#magi > .magi--name { color: $nerv; text-style: bold; }
#magi > .magi--label { color: $nerv; }
#magi > .magi--word-approve { background: $nominal; color: $void; text-style: bold; }
#magi > .magi--word-reject { background: $alert; color: $ink; text-style: bold; }
#magi > .magi--word-pending { background: $amber; color: $void; text-style: bold; }
#magi > .magi--word-none { color: $grid; }

#related, #sync {
    height: auto;
    margin: 1 0 0 0;
}
#comm {
    height: 1fr;
    margin: 1 0 0 0;
}
#related > .related--title, #sync > .sync--title, #comm > .comm--title {
    color: $nerv;
    text-style: bold;
}
#related > .related--note, #sync > .sync--note, #comm > .comm--note { color: $dim; }
#related > .related--number { color: $nerv; text-style: bold; }
#related > .related--provider { color: $amber; }
#related > .related--text { color: $ink; }
#related > .related--age { color: $mint; }
#sync > .sync--grid { color: $grid; }
#sync > .sync--trace { color: $nominal; }
#sync > .sync--user { color: $amber; text-style: bold; }
#comm > .comm--lost { background: $alert; color: $ink; text-style: bold; }
#comm > .comm--role-user { background: $amber; color: $void; text-style: bold; }
#comm > .comm--role-assistant { color: $nominal; text-style: bold; }
#comm > .comm--role-tool { color: $grid; }
#comm > .comm--text { color: $ink; }

/* --- the boot log -------------------------------------------------------------------- */
#boot {
    layer: boot;
    width: 100%;
    height: 100%;
    padding: 1 2;
    background: $void;
    text-wrap: nowrap;
}
#boot > .boot--head { color: $alert; text-style: bold; }
#boot > .boot--line { color: $nerv; }
#boot > .boot--ok { color: $nerv; text-style: bold; }
#boot > .boot--wait { color: $amber; }
#boot > .boot--lost { color: $alert; text-style: bold; }
#boot > .boot--done { color: $nominal; text-style: bold; }

/* --- prompts: caution in orange, danger under a hazard band ------------------------ */
#stripe-top, #stripe-bottom {
    height: 1;
    background: $void;
    text-wrap: nowrap;
}
#stripe-top > .hazard--stripe, #stripe-bottom > .hazard--stripe {
    color: $alert;
}
#stripe-top > .hazard--label, #stripe-bottom > .hazard--label {
    background: $alert;
    color: $void;
    text-style: bold;
}
#prompt {
    height: auto;
    padding: 0 1;
    text-style: bold;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}
#prompt.-caution {
    border-left: thick $nerv;
    background: $ember;
    color: $amber;
}
#prompt.-danger {
    border-left: thick $alert;
    background: $alert-deep;
    color: $ink;
}
#prompt.-flash {
    background: $ink;
    color: $void;
}
#filterbar, #folderbar {
    height: 1;
}
#filter-label, #folder-label {
    width: auto;
    height: 1;
    padding: 0 0 0 1;
    color: $nerv;
    text-style: bold;
}
#filter, #folder {
    width: 1fr;
    height: 1;
    border: none;
    padding: 0 1;
    background: $void;
    color: $amber;
}
#filter:focus, #folder:focus {
    border: none;
}
#hints {
    height: auto;
    padding: 0 1;
    text-wrap: nowrap;
    border-top: solid $grid;
}
#hints > .hints--key {
    background: $nerv;
    color: $void;
    text-style: bold;
}
#hints > .hints--action {
    color: $dim;
}

/* A short terminal keeps its rows for the list: no frames. */
#main.-compact #board {
    border: none;
}
#main.-compact #hints {
    border-top: none;
}


/* --- help overlay ------------------------------------------------------------------ */
HelpScreen {
    background: $void;
    align: center middle;
}
#help {
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: 100%;
    padding: 0 1;
    background: $void;
    border: heavy $nerv;
    border-title-color: $amber;
    border-title-style: bold;
    overflow-x: hidden;
    overflow-y: auto;
    scrollbar-size-vertical: 1;
    scrollbar-color: $nerv;
    scrollbar-color-hover: $amber;
    scrollbar-color-active: $amber;
    scrollbar-background: $ember;
    scrollbar-background-hover: $ember;
    scrollbar-background-active: $ember;
}
#help-title, #help-text, #help-hint {
    width: auto;
}
#help-title {
    color: $nerv;
    text-style: bold;
    margin: 0 0 1 0;
}
#help-text {
    color: $ink;
}
#help-hint {
    color: $dim;
    margin: 1 0 0 0;
}

/* --- transcript pager ---------------------------------------------------------------- */
#pager-title {
    height: 1;
    padding: 0 1;
    background: $nerv;
    color: $void;
    text-style: bold;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}
#pager-body {
    height: 1fr;
    padding: 0 1;
    scrollbar-gutter: stable;   /* no re-wrap when the scrollbar appears */
    border-top: heavy $nerv;
    border-bottom: heavy $nerv;
    border-title-color: $amber;
    border-title-style: bold;
    overflow-x: hidden;
    scrollbar-size-vertical: 1;
    scrollbar-color: $nerv;
    scrollbar-color-hover: $amber;
    scrollbar-color-active: $amber;
    scrollbar-background: $ember;
    scrollbar-background-hover: $ember;
    scrollbar-background-active: $ember;
}
#pager-body > .transcript--role-user {
    background: $amber;
    color: $void;
    text-style: bold;
}
#pager-body > .transcript--role-assistant {
    color: $nominal;
    text-style: bold;
}
#pager-body > .transcript--role-tool {
    color: $grid;
}
#pager-body > .transcript--note {
    color: $dim;
}
#pager-body > .transcript--text {
    color: $ink;
}
#pager-footer {
    height: 1;
}
#pager-hints {
    width: 1fr;
    height: 1;
    padding: 0 1;
    color: $dim;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}
#pager-status {
    width: auto;
    height: 1;
    padding: 0 1;
    color: $mint;
    text-wrap: nowrap;
}
#pager-status.-error {
    color: $alert;
}
